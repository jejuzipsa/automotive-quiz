{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "자동차정비산업기사 구 기출 개인보관용 회차 JSON",
  "type": "object",
  "required": [
    "exam_date",
    "round_numbers",
    "source",
    "questions"
  ],
  "properties": {
    "exam_date": {
      "type": "string",
      "enum": [
        "2020-08-22",
        "2020-06-06",
        "2019-08-04",
        "2019-04-27",
        "2019-03-03",
        "2018-08-19",
        "2018-04-28",
        "2018-03-04"
      ]
    },
    "round_numbers": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "required": [
        "filename",
        "sha256",
        "rights_status"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rights_status": {
          "enum": [
            "unverified",
            "permission_confirmed"
          ]
        },
        "url": {
          "type": "string"
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question_number",
          "original_subject",
          "question",
          "choices",
          "answer",
          "explanation",
          "assets",
          "source_page",
          "transcription_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^legacy-[0-9]{4}-[0-9]{2}-[0-9]{2}-q[0-9]{2}$"
          },
          "question_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 80
          },
          "original_subject": {
            "enum": [
              "legacy_mechanics",
              "legacy_engine",
              "legacy_chassis",
              "legacy_electrical"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          },
          "answer": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "explanation": {
            "type": [
              "string",
              "null"
            ]
          },
          "explanation_origin": {
            "enum": [
              "source",
              "independent",
              "missing"
            ]
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "role"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "question",
                    "choice1",
                    "choice2",
                    "choice3",
                    "choice4",
                    "explanation"
                  ]
                }
              }
            }
          },
          "source_page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "transcription_status": {
            "enum": [
              "pending",
              "source_compared",
              "needs_review"
            ]
          },
          "technical_review": {
            "enum": [
              "unreviewed",
              "needs_review",
              "verified"
            ]
          },
          "current_subject": {
            "enum": [
              "engine",
              "chassis",
              "electrical",
              "eco",
              null
            ]
          },
          "current_scope_status": {
            "enum": [
              "unreviewed",
              "within_scope",
              "outside_scope",
              "uncertain"
            ]
          }
        }
      }
    }
  }
}
